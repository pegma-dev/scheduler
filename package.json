{
  "name": "scheduler",
  "version": "0.0.0",
  "private": true,
  "description": "Durable coordination for host-triggered recurring Pegma work.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "fixtures/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false && tsc -p tsconfig.d1-test.json --pretty false",
    "clean": "tsc -b --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:check": "node scripts/release-packages.mjs check",
    "release:pack": "node scripts/release-packages.mjs pack",
    "release:publish": "node scripts/release-packages.mjs publish",
    "test": "pnpm run build && pnpm run test:node && pnpm run test:d1",
    "test:node": "vitest run --config vitest.config.ts",
    "test:d1": "vitest run --config vitest.d1.config.ts"
  },
  "devDependencies": {
    "@azure/data-tables": "^13.3.2",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260731.1",
    "@pegma/storage-azure-tables": "^0.4.0",
    "@pegma/storage-cloudflare-d1": "0.4.1",
    "@types/node": "^26.1.1",
    "azurite": "^3.36.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
