{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "fixtures/**/*.ts",
    "tests/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.d.mts",
    "vitest.config.ts",
    "vitest.d1.config.ts"
  ],
  "exclude": ["packages/**/*.d1.test.ts"]
}
